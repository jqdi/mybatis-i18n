<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.jqdi</groupId>
	<artifactId>mybatis-i18n</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<name>mybatis-i18n</name>
	<description>mybatis 国际化</description>
	<url>https://github.com/jqdi/mybatis-i18n</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>jqdi</id>
			<name>JQ棣</name>
			<email>897665787@qq.com</email>
			<url>https://github.com/jqdi</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/jqdi/mybatis-i18n.git</connection>
		<developerConnection>scm:git:https://github.com/jqdi/mybatis-i18n.git</developerConnection>
		<url>https://github.com/jqdi/mybatis-i18n</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<!--项目版本定义、升级统一改这里-->
		<revision>1.0.2</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>
	</properties>

	<modules>
		<!-- 核心模块 -->
		<module>mybatis-i18n-core</module>
		<module>mybatis-i18n-spring-boot-starter</module>
		<module>mybatis-i18n-springboot-demo</module>
	</modules>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!--编译插件-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<encoding>${project.build.sourceEncoding}</encoding>
				</configuration>
			</plugin>
			<!--跳过测试-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<!--配置生成源码包-->
	        <plugin>
	            <groupId>org.apache.maven.plugins</groupId>
	            <artifactId>maven-source-plugin</artifactId>
	            <executions>
	                <execution>
	                    <id>attach-sources</id>
	                    <goals>
	                        <goal>jar</goal>
	                    </goals>
	                </execution>
	            </executions>
	        </plugin>
			<!--配置生成Javadoc文档-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<skip>true</skip>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--配置部署插件-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
			</plugin>
			<!--构建过程中，将占位符替换为实际值-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.7.0</version>
				<configuration>
					<!-- 是否将生成的扁平化POM设置为项目文件 -->
					<updatePomFile>true</updatePomFile>
					<!-- 扁平化模式，常用的是处理占位符 -->
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<!-- 绑定到process-resources阶段，自动执行flatten目标 -->
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<!-- 清理生成的文件 -->
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
        </plugins>
	</build>
</project>
